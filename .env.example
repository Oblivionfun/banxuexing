# 域名（Caddy 用它自动申请 HTTPS 证书）
DOMAIN=example.com

# 站点对外地址，用于生成分享链接和企业微信推送里的链接
SITE_URL=https://example.com

# 家长和老师私密链接里的随机串，更换后旧链接全部失效
# 生成：openssl rand -base64 24 | tr -d '/+='
SHARE_TOKEN=

# 工作人员进入 /admin 的管理口令，至少 6 位
ADMIN_PASSCODE=

# Cookie 签名密钥，至少 32 位
# 生成：openssl rand -hex 32
SESSION_SECRET=

# 数据目录：数据库、上传文件、备份都在这里
DATA_DIR=./data

# 可选：用大模型整理老师发来的课后总结（OpenAI 兼容接口，如 DeepSeek、通义千问、Kimi）
# 不填时使用内置的规则拆分，功能照常可用
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 可选：异地备份目标（rclone 远端名:桶名/目录），例如 cos:banxuexing-backup-1250000000
BACKUP_REMOTE=
# 本机保留几天的数据库备份；远端保留多久
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP=60d
